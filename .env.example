# Biến Môi Trường — Yến Sào Manager

# ─── Google Sheets ──────────────────────────────────────────────────────────
# ID của Google Spreadsheet (lấy từ URL: .../spreadsheets/d/[ID_Ở_ĐÂY]/edit)
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Service Account credentials (JSON dạng 1 dòng, copy từ file .json đã tải về)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ─── Frontend (VITE_ prefix = expose ra browser) ────────────────────────────
# Bật chế độ Google Sheets API (true = dùng API; false = dùng localStorage)
VITE_HAS_GOOGLE_SHEETS_API=true

# ─── Hướng Dẫn Lấy Credentials ──────────────────────────────────────────────
# 1. Vào https://console.cloud.google.com
# 2. Tạo project mới → Enable "Google Sheets API"
# 3. IAM & Admin → Service Accounts → Create Service Account
# 4. Tạo key JSON → Tải file về
# 5. Copy nội dung file JSON → dán vào GOOGLE_SERVICE_ACCOUNT_JSON (1 dòng)
# 6. Copy email service account (dạng xxx@yyy.iam.gserviceaccount.com)
# 7. Mở Google Sheet → Share → Dán email đó vào, quyền Editor
#
# Đặt tên file này thành .env.local (dev) hoặc nhập vào Vercel Dashboard (production)
# KHÔNG commit .env.local lên git!
